# ===== DeepSeek API 配置 =====
# 在 platform.deepseek.com 申请 API Key 后填入
DEEPSEEK_API_KEY=sk-xxxx

# API 地址（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名：默认 deepseek-v4-flash（deepseek-chat 已于 2026-07 停用）
# 可选 deepseek-v4-pro（更强推理、更贵）
DEEPSEEK_MODEL=deepseek-v4-flash

# 思考模式：disabled（默认，稳定快速）| enabled（开启思考，兼容 reasoning_content）
DEEPSEEK_THINKING=disabled

# 单次回复最大输出 token 数
DEEPSEEK_MAX_TOKENS=8192

# ===== Agent 配置 =====
# 单轮对话最大迭代次数（一次 LLM 调用 = 一次迭代）
AGENT_MAX_ITERATIONS=8

# 文件工具的工作目录（相对路径基于项目根目录）
AGENT_WORKSPACE=workspace

# 会话保存目录
AGENT_SESSIONS_DIR=sessions

# run_code 工具的执行超时（秒，上限 60）
RUN_TIMEOUT=15

# 上下文记忆滑动窗口大小（消息条数）
MEMORY_MAX_MESSAGES=20

# 上下文记忆 token 预算（估算值，超过则缩小窗口）
MEMORY_MAX_TOKENS=64000
